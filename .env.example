# Copy to `.env` and fill in. NEVER commit `.env` — it is git-ignored (CLAUDE.md §12).

# Environment: dev | test | prod
STEWARD_ENV=dev

# Safety: keep dry-run ON until you explicitly enable live, world-mutating
# actions. New action types ship in dry-run (CLAUDE.md §5).
STEWARD_DRY_RUN=true

# Per-kind live opt-in (comma-separated ActionKind values, e.g.
# "post_issue_comment,apply_labels"). Live execution needs BOTH
# STEWARD_DRY_RUN=false AND the kind listed here. Empty = nothing runs live.
STEWARD_LIVE_ACTIONS=

# Anthropic — model access (required for real model calls).
ANTHROPIC_API_KEY=

# Voyage AI — embeddings for duplicate-issue detection (required for live dedup;
# install the 'dedup' extra: uv sync --extra dedup). See ADR-0002.
VOYAGE_API_KEY=

# Langfuse — observability. Optional: tracing degrades to a no-op when absent.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# GitHub — token scoped to the TARGET repo only (least privilege, CLAUDE.md §12).
GITHUB_TOKEN=
# The repo Steward acts on, as owner/name. Must be a repo you own/control.
STEWARD_GITHUB_REPO=owner/repo
